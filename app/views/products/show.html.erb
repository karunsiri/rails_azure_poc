<div class="max-w-3xl mx-auto py-12 px-4 sm:px-6">
  <div class="mb-8">
    <%= link_to products_path, class: "inline-flex items-center text-sm font-medium text-stone-500 hover:text-teal-600 transition-colors mb-6" do %>
      <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to products
    <% end %>
    <h1 class="text-3xl font-semibold text-stone-900 tracking-tight"><%= @product.name %></h1>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-stone-200/80 p-6 mb-8">
    <dl class="space-y-4">
      <div>
        <dt class="text-sm font-medium text-stone-500 uppercase tracking-wider">Name</dt>
        <dd class="mt-1 text-lg text-stone-900"><%= @product.name %></dd>
      </div>
    </dl>
  </div>

  <div class="flex flex-wrap gap-3">
    <%= link_to edit_product_path(@product), class: "inline-flex items-center rounded-lg bg-teal-600 px-4 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-teal-500 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:ring-offset-2 transition-colors" do %>
      <svg class="-ml-0.5 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
      </svg>
      Edit
    <% end %>
    <%= button_to @product, method: :delete, data: { turbo_confirm: "Are you sure you want to delete this product?" }, class: "inline-flex items-center rounded-lg border border-red-200 bg-white px-4 py-2.5 text-sm font-medium text-red-700 hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 transition-colors" do %>
      <svg class="-ml-0.5 mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
      </svg>
      Delete
    <% end %>
  </div>
</div>
